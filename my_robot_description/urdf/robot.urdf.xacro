<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- Propiedades generales -->
  <xacro:property name="pi" value="3.14159265359"/>

  <!-- Macro para crear eslabones con masa, visual y colision -->
  <xacro:macro name="robot_link" params="name length radius mass">

    <link name="${name}">

      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${length}" radius="${radius}"/>
        </geometry>
        <material name="blue">
          <color rgba="0.1 0.3 0.9 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${length}" radius="${radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass*(3*radius*radius+length*length)/12}"
          ixy="0"
          ixz="0"
          iyy="${mass*(3*radius*radius+length*length)/12}"
          iyz="0"
          izz="${mass*radius*radius/2}"/>
      </inertial>

    </link>

  </xacro:macro>

  <!-- Base del robot -->
  <link name="link_base">
    <visual>
      <geometry>
        <box size="0.4 0.4 0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.4 0.4 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="5.0"/>
      <inertia
        ixx="0.0833"
        ixy="0"
        ixz="0"
        iyy="0.0833"
        iyz="0"
        izz="0.1333"/>
    </inertial>
  </link>

  <!-- Eslabones -->
  <xacro:robot_link name="link_1" length="0.5" radius="0.06" mass="2.0"/>
  <xacro:robot_link name="link_2" length="0.4" radius="0.05" mass="1.5"/>
  <xacro:robot_link name="link_3" length="0.3" radius="0.04" mass="1.0"/>
  <xacro:robot_link name="link_4" length="0.2" radius="0.03" mass="0.5"/>

  <!-- Articulacion 1 -->
  <joint name="joint_1" type="revolute">
    <parent link="link_base"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <!-- Articulacion 2 -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Articulacion 3 -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.4"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Articulacion 4 -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Efector final -->
  <link name="link_final">
    <visual>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.000512"
        ixy="0"
        ixz="0"
        iyy="0.000512"
        iyz="0"
        izz="0.000512"/>
    </inertial>
  </link>

  <joint name="joint_final" type="fixed">
    <parent link="link_4"/>
    <child link="link_final"/>
    <origin xyz="0 0 0.2"/>
  </joint>

</robot>
